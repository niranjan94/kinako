<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.niranjan.kinako</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Kinako</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="io.niranjan">
    <name>Niranjan Rajendran</name>
  </developer>
  <description>
    <p>
      Kinako is an open-source desktop app for coding agents, based on T3 Code.
      Work with your existing agent subscriptions, review code changes, and run
      commands in your projects.
    </p>
    <p>
      Connect from desktop, web, or mobile to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">kinako-desktop.desktop</launchable>
  <icon type="stock">kinako-desktop</icon>
  <provides>
    <binary>kinako-desktop</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://github.com/niranjan94/kinako</url>
  <url type="bugtracker">https://github.com/niranjan94/kinako/issues</url>
  <url type="vcs-browser">https://github.com/niranjan94/kinako</url>
</component>
